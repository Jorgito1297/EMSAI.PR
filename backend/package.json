{
  "name": "clere-core-audit-engine",
  "version": "1.0.0",
  "description": "Core Audit Engine (CAE) para CLERE - Centro de Liderazgo en Respuestas a Emergencias",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testEnvironment=node --forceExit",
    "test:coverage": "jest --coverage --testEnvironment=node --forceExit",
    "lint": "eslint src/ tests/ --ext .js"
  },
  "keywords": [
    "clere",
    "ems",
    "audit",
    "clinical-simulation",
    "emergency-medical-services"
  ],
  "author": "CLERE Team",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
