# ===========================================
# CLERE Core Audit Engine - Environment Config
# ===========================================

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/clere_db

# Configuración del servidor
NODE_ENV=development
PORT=3000

# Seguridad JWT (CAMBIAR en producción — generar con: openssl rand -hex 64)
JWT_SECRET=your-secret-key-change-in-production

# CORS — orígenes permitidos (separados por coma)
# Desarrollo: frontend Next.js corre en :3001
# Producción: reemplazar con el dominio real
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# TODO: Configuración de Redis (próxima fase)
# REDIS_URL=redis://localhost:6379

# TODO: Configuración de n8n (integración AI)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/clere-events

# TODO: Configuración de AWS (producción)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=clere-audit-logs
