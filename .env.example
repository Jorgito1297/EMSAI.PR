# =============================================================
# CLERE — Root environment variables (docker-compose)
# Copy this file to .env and fill in production values.
# NEVER commit .env to source control.
# =============================================================

# Backend API URL (used by frontend; change to your domain in production)
NEXT_PUBLIC_API_URL=http://localhost:3000

# CORS origins the backend will accept (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001

# JWT secret — generate a strong value with: openssl rand -hex 64
JWT_SECRET=dev-secret-change-in-production
